CompileFlags:
  Remove:
    - "-forward-unknown-to-host-compiler"
    - "--forward-unknown-to-host-compiler"
    - "--generate-code=*"
    - "-gencode=*"
    - "--options-file=*"
    - "-Xcompiler=*"
  Add:
    - "-xcuda"
    - "--cuda-path=/usr/local/cuda"
    - "-std=c++20"
Diagnostics:
  UnusedIncludes: Strict
